# Copy this file to `.env` and fill in the values.
#
#   cp .env.example .env
#
# A single .env feeds BOTH sides:
#   - docker compose  -> substitutes ${VAR} when starting Postgres
#   - the application -> pydantic-settings reads the same variable names
#
# `.env` is git-ignored. Never commit real secrets.

# --- Database ---------------------------------------------------------------
# DB_USER / DB_PASSWORD / DB_NAME create the Postgres container on first run.
# Changing them afterwards requires recreating the volume:
#   docker compose down -v && docker compose up -d
DB_USER=vetglobal
DB_PASSWORD=
DB_NAME=vetglobal

# Host as seen BY THE APPLICATION.
#   127.0.0.1 -> API running on your machine (default)
#   database  -> API running inside docker compose
DB_HOST=127.0.0.1
DB_PORT=5432

# --- Auth (D26 / D27) -------------------------------------------------------
# Generate each with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Shared secret required by the /internal/* worker endpoints.
INTERNAL_TOKEN=

# --- Long polling (D13 / D19) -----------------------------------------------
# How long a poll request is held open before returning `timed_out: true`.
POLL_TIMEOUT_SECONDS=25
# Safety-net re-query interval. LISTEN/NOTIFY is not persistent, so a missed
# notification is recovered by this re-check -- it is what makes the design
# correct, not merely fast.
POLL_RECHECK_SECONDS=5

# --- Upload validation (D25) ------------------------------------------------
MAX_UPLOAD_BYTES=10485760
MIN_CONTENT_CHARS=20
